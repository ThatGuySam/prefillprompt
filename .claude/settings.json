{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push *--force)",
      "Bash(git push *--force *)",
      "Bash(git push -f)",
      "Bash(git push * -f)",
      "Bash(git push *-f *)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git config *core.hooksPath*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh repo delete *)"
    ],
    "ask": [
      "Bash(git switch -c *)",
      "Bash(git switch -C *)",
      "Bash(git switch --create *)",
      "Bash(git switch --orphan *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git worktree add *)",
      "Bash(gh pr create *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git stash)",
      "Bash(git stash push*)",
      "Bash(git stash save*)",
      "Bash(git stash -*)",
      "Bash(mise trust*)"
    ]
  }
}
