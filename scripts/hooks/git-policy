#!/usr/bin/env sh
# Trunk-based Git policy guard. See docs/workflows/trunk-policy.md.
# Modes: commit | reference-transaction <state> | pre-push <remote> <url>
set -eu

deny() {
  printf '%s\n' "Git policy: $*" >&2
  exit 1
}

trunk=$(git config --local --get starter.trunkBranch 2>/dev/null || :)
[ -n "$trunk" ] || trunk=main
authorized=$(git config --local --get starter.authorizedBranch 2>/dev/null || :)

allowed() {
  [ "$1" = "$trunk" ] || { [ -n "$authorized" ] && [ "$1" = "$authorized" ]; }
}
is_zero() {
  case "$1" in
    '' | *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

case "${1-}" in
  commit)
    branch=$(git symbolic-ref --quiet --short HEAD) ||
      deny "Detached commits need a human's explicit request. Work on $trunk."
    allowed "$branch" ||
      deny "Commits on '$branch' need a human's request for that exact branch and local starter.authorizedBranch."
    ;;
  reference-transaction)
    [ "${2-}" = prepared ] || exit 0
    while read -r old new ref; do
      is_zero "$new" && continue
      if [ "$ref" = HEAD ] && is_zero "$old"; then
        case "$new" in
          *[!0-9a-fA-F]*) ;;
          *)
            detached=$(git config --local --type=bool --get starter.authorizedDetachedCheckout 2>/dev/null || :)
            [ "$detached" = true ] ||
              deny "A new detached checkout or worktree needs a human's explicit request and one-use local starter.authorizedDetachedCheckout=true."
            git config --local --unset starter.authorizedDetachedCheckout ||
              deny 'Could not consume the detached checkout authorization.'
            ;;
        esac
      fi
      case "$ref" in
        refs/heads/*)
          branch=${ref#refs/heads/}
          allowed "$branch" && continue
          # An unspecified old value is also zero when an existing ref is updated.
          git show-ref --verify --quiet "$ref" && continue
          deny "Creating branch '$branch' needs a human's request for that exact branch and local starter.authorizedBranch."
          ;;
      esac
    done
    ;;
  pre-push)
    while read -r _local_ref local_oid remote_ref remote_oid; do
      is_zero "$local_oid" && continue
      case "$remote_ref" in
        refs/heads/*)
          branch=${remote_ref#refs/heads/}
          allowed "$branch" ||
            deny "Pushing to '$remote_ref' needs a human's request for that exact branch and local starter.authorizedBranch."
          if ! is_zero "$remote_oid"; then
            git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null ||
              deny "Non-fast-forward push to '$remote_ref' is not covered by this policy. Ask a human."
          fi
          ;;
      esac
    done
    ;;
  *) deny 'Unknown guard operation.' ;;
esac
