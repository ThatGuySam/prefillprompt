{
    "name": "prefillprompt",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@10.12.4",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "build": "nuxt build",
        "build:cloudflare": "nuxt build --preset=cloudflare-module",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:cloudflare",
        "deploy:blue": "pnpm build:cloudflare && wrangler versions upload --preview-alias blue",
        "deploy:preview": "pnpm build:cloudflare && wrangler versions upload --preview-alias rest-features",
        "dev": "nuxt dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "models:update": "node scripts/update-model-catalog.mjs",
        "postinstall": "nuxt prepare",
        "preview": "wrangler dev",
        "test": "node --experimental-strip-types --test test/*.test.ts",
        "typecheck": "nuxt typecheck"
    },
    "dependencies": {
        "nuxt": "^3.17.6",
        "qrcode": "^1.5.4",
        "vue": "^3.4.27"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.2.0",
        "@types/eslint": "~9.6.1",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.8.0",
        "typescript": "~5.8.3",
        "vue-tsc": "~2.2.10",
        "wrangler": "^4.115.0"
    }
}
